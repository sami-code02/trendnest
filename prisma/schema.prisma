generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH / USERS
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  wishlist      WishlistItem[]
  blogPosts     BlogPost[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  bannerImage String?
  seoTitle    String?
  seoDescription String? @db.Text
  parentId    String?
  parent      Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToParent")
  products    Product[]
  createdAt   DateTime @default(now())
}

enum AffiliateNetwork {
  AMAZON
  FLIPKART
  MYNTRA
  AJIO
  MEESHO
  OTHER
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  brand       String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  price       Decimal  @db.Decimal(10, 2)
  oldPrice    Decimal? @db.Decimal(10, 2)
  discountPct Int?

  description String   @db.Text
  features    String[]
  specs       Json?     // { key: value } spec table
  pros        String[]
  cons        String[]
  faqs        ProductFaq[]

  rating      Float    @default(0)
  reviewCount Int      @default(0)

  images         ProductImage[]
  pinterestImage String?
  pinterestTitle String?
  pinterestDesc  String? @db.Text

  seoTitle       String?
  seoDescription String? @db.Text
  keywords       String[]
  tags           String[]

  affiliateNetwork AffiliateNetwork @default(AMAZON)
  affiliateUrl     String
  disclosureText   String  @default("As an affiliate, we earn from qualifying purchases.")

  isFeatured   Boolean @default(false)
  isTrending   Boolean @default(false)
  isBestSeller Boolean @default(false)
  isNewArrival Boolean @default(false)
  isPublished  Boolean @default(false)

  wishlistedBy WishlistItem[]
  clicks       AffiliateClick[]
  relatedTo    RelatedProduct[] @relation("BaseProduct")
  relatedFrom  RelatedProduct[] @relation("RelatedProduct")
  blogLinks    BlogPostProduct[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
  @@index([isFeatured, isTrending, isBestSeller, isNewArrival])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String  @db.Text
}

model RelatedProduct {
  id              String  @id @default(cuid())
  baseProductId   String
  baseProduct     Product @relation("BaseProduct", fields: [baseProductId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct  Product @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([baseProductId, relatedProductId])
}

// ---------------------------------------------------------------------------
// WISHLIST
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// BLOG / CMS
// ---------------------------------------------------------------------------

model BlogPost {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  excerpt        String?  @db.Text
  content        String   @db.Text // markdown / MDX
  featuredImage  String?
  authorId       String?
  author         User?    @relation(fields: [authorId], references: [id])
  seoTitle       String?
  seoDescription String?  @db.Text
  tags           String[]
  isPublished    Boolean  @default(false)
  publishedAt    DateTime?
  products       BlogPostProduct[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BlogPostProduct {
  id         String   @id @default(cuid())
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, productId])
}

// ---------------------------------------------------------------------------
// HOMEPAGE SECTIONS (admin-editable, no code changes needed)
// ---------------------------------------------------------------------------

enum HomeSectionType {
  HERO
  TRENDING
  DEALS
  BEST_SELLERS
  EDITORS_PICKS
  NEW_ARRIVALS
  CATEGORIES
  COLLECTIONS
  PINTEREST_GALLERY
  BLOG
  TESTIMONIALS
  NEWSLETTER
  FAQ
}

model HomeSection {
  id        String          @id @default(cuid())
  type      HomeSectionType
  title     String?
  subtitle  String?
  position  Int             @default(0)
  isVisible Boolean         @default(true)
  config    Json?           // section-specific settings (e.g. product ids, limit)
}

// ---------------------------------------------------------------------------
// AFFILIATE TRACKING
// ---------------------------------------------------------------------------

model AffiliateClick {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  utmSource String?
  utmMedium String?
  utmCampaign String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// ---------------------------------------------------------------------------
// NEWSLETTER
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// BULK IMPORT AUDIT
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

model ImportJob {
  id           String       @id @default(cuid())
  fileName     String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  successRows  Int          @default(0)
  failedRows   Int          @default(0)
  errorReport  Json?
  createdAt    DateTime     @default(now())
}
